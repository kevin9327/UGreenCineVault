{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uliya.local/schemas/capability-catalog.schema.json",
  "title": "Uliya NAS CLI Capability Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "catalogVersion",
    "generatedAt",
    "invocation",
    "domains",
    "clis"
  ],
  "properties": {
    "catalogVersion": {
      "type": "string",
      "const": "2.0.0"
    },
    "generatedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "invocation": {
      "$ref": "#/$defs/invocation"
    },
    "guide": {
      "$ref": "#/$defs/guide"
    },
    "domains": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/domain"
      }
    },
    "clis": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/cli"
      }
    }
  },
  "$defs": {
    "guide": {
      "type": "object",
      "additionalProperties": false,
      "required": ["glossary", "domains", "scenarios"],
      "properties": {
        "glossary": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/glossaryItem"}
        },
        "domains": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/domainGuide"}
        },
        "scenarios": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/scenario"}
        }
      }
    },
    "glossaryItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["term", "meaning"],
      "properties": {
        "term": {"type": "string", "minLength": 1},
        "meaning": {"type": "string", "minLength": 1}
      }
    },
    "domainGuide": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain", "typicalRequests", "boundaries"],
      "properties": {
        "domain": {"type": "string", "minLength": 1},
        "typicalRequests": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "boundaries": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "userRequest", "steps", "boundary"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "userRequest": {"type": "string", "minLength": 1},
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/scenarioStep"}
        },
        "boundary": {"type": "string", "minLength": 1}
      }
    },
    "scenarioStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cli", "action", "purpose"],
      "properties": {
        "cli": {"type": "string", "minLength": 1},
        "action": {"type": "string", "minLength": 1},
        "purpose": {"type": "string", "minLength": 1}
      }
    },
    "invocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "resultEnvelope"
      ],
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1
        },
        "resultEnvelope": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "success",
            "failure"
          ],
          "properties": {
            "success": {
              "type": "object"
            },
            "failure": {
              "type": "object"
            }
          }
        }
      }
    },
    "domain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "description"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "cli": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "domain",
        "description",
        "agent",
        "actions"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "domain": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "agent": {
          "type": "string",
          "enum": [
            "media-agent",
            "file-agent",
            "document-agent",
            "knowledge-agent",
            "photo-agent",
            "security-monitor-agent"
          ]
        },
        "actions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/action"
          }
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "description",
        "parameters",
        "effect",
        "approval",
        "returnSummary",
        "example",
        "permissions",
        "prerequisites",
        "errorCodes",
        "stability",
        "completionEvidence"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9-]*$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "parameters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/parameter"
          }
        },
        "effect": {
          "enum": [
            "read",
            "state-change",
            "mixed"
          ]
        },
        "approval": {
          "enum": [
            "none",
            "gateway",
            "conditional",
            "workflow"
          ]
        },
        "returnSummary": {
          "type": "string",
          "minLength": 1
        },
        "example": {
          "$ref": "#/$defs/example"
        },
        "permissions": {
          "$ref": "#/$defs/knowledge"
        },
        "prerequisites": {
          "$ref": "#/$defs/knowledge"
        },
        "errorCodes": {
          "$ref": "#/$defs/knowledge"
        },
        "stability": {
          "enum": [
            "stable",
            "experimental",
            "unknown"
          ]
        },
        "completionEvidence": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type",
        "required",
        "repeatable"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "string",
            "integer",
            "number",
            "boolean",
            "array",
            "object"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "repeatable": {
          "type": "boolean"
        },
        "default": {},
        "enum": {
          "type": "array",
          "minItems": 1
        },
        "minimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "example": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "outputStatus"
      ],
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1
        },
        "outputStatus": {
          "enum": [
            "known",
            "unknown"
          ]
        },
        "output": {}
      }
    },
    "knowledge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "knowledgeStatus"
      ],
      "properties": {
        "knowledgeStatus": {
          "enum": [
            "known",
            "unknown"
          ]
        },
        "items": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
